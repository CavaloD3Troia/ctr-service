<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.cavalodetroia</groupId>
    <artifactId>ctr-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ctr-service</name>
    <description>Control Tower: the only backend the UI talks to</description>

    <modules>
        <module>domain</module>
        <module>api</module>
        <module>infra</module>
        <module>application</module>
        <module>component-tests</module>
    </modules>

    <properties>
        <java.version>25</java.version>

        <!-- Shared Kafka contracts: 0.2.0 brings ClipPairUploaded and ClipReady (TH-133). Bump to the released version
             once GlobalProtobufModels is tagged. -->
        <global-protobuf-models.version>0.2.0-SNAPSHOT</global-protobuf-models.version>

        <archunit.version>1.5.1</archunit.version>
        <!-- JMX over HTTP for Hawtio, local profile only. Not managed by the Spring Boot parent -->
        <jolokia.version>2.6.5</jolokia.version>
        <cucumber.version>8.0.4</cucumber.version>
        <!-- The 3.x line is the one built for Spring Boot 4 -->
        <springdoc.version>3.2.0</springdoc.version>
        <!-- The S3 client, for the HEAD that confirms an uploaded clip -->
        <aws-sdk.version>2.57.9</aws-sdk.version>
        <!-- Not managed by the Spring Boot parent -->
        <jacoco.version>0.8.16</jacoco.version>

        <!-- jacoco:prepare-agent puts its agent here. It stays empty in the modules without a coverage gate, so the
             @{argLine} in the surefire configuration still resolves -->
        <argLine></argLine>

        <!-- Component and integration tests need Docker, so they only run with -Pcomponent-tests / -Pintegration-tests -->
        <skipComponentTests>true</skipComponentTests>
        <skipIntegrationTests>true</skipIntegrationTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.cavalodetroia</groupId>
                <artifactId>ctr-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.cavalodetroia</groupId>
                <artifactId>ctr-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.cavalodetroia</groupId>
                <artifactId>ctr-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.cavalodetroia</groupId>
                <artifactId>ctr-application</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.cavalodetroia</groupId>
                <artifactId>global-protobuf-models</artifactId>
                <version>${global-protobuf-models.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!-- Declared first so every other dependency keeps coming from Maven Central -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <!-- GlobalProtobufModels releases. Needs a read:packages token in ~/.m2/settings.xml (see README) -->
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/CavaloD3Troia/GlobalProtobufModels</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Line coverage from the unit tests (surefire), gated per module where the plugin is bound (domain,
                     api and infra). Bound to verify, so `make build` fails below the threshold. Never lower the
                     threshold or widen the excludes to pass: add the test -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <!-- Generated by jooq-codegen from the migrations -->
                            <exclude>org/cavalodetroia/ctr/infra/persistence/jooq/**</exclude>
                            <!-- The Spring Boot entry point -->
                            <exclude>org/cavalodetroia/ctr/application/CtrApplication.class</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.80</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Every module tests with Mockito: load it as a Java agent instead of letting it self-attach (the JDK warns) -->
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} is the JaCoCo agent, resolved late so jacoco:prepare-agent has run first.
                         -Xshare:off: class data sharing is not compatible with the agent and only adds a warning -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>component-tests</id>
            <properties>
                <skipComponentTests>false</skipComponentTests>
            </properties>
        </profile>
        <profile>
            <id>integration-tests</id>
            <properties>
                <skipIntegrationTests>false</skipIntegrationTests>
            </properties>
        </profile>
    </profiles>
</project>
